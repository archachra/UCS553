package library.main;
import library.model.*;
public class Main {
public static void main(String[] args) {
LibraryResource[] resources =
new LibraryResource[5];
resources[0] = new Book(1,"Java","James");
resources[1] = new DigitalResource(2,"AI","John");
resources[2] = new Book(3,"DBMS","Korth");
resources[3] = new DigitalResource(4,"Python","Guido");
resources[4] = new Book(5,"Networks","Tanenbaum");
int[] overdueDays = {5,10,3,7,2};
double totalFine = 0;
for(int i=0;i<resources.length;i++) {
Printable p = (Printable)resources[i];
p.printDetails();
double fine =
resources[i].calculateFine(overdueDays[i]);
System.out.println("Fine: "+fine);
totalFine += fine;
}
System.out.println("Total Fine: "+totalFine);
LibraryResource.displayTotalResources();
}
}
